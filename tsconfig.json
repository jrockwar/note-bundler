{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": ["DOM", "ES2020"],
    "types": ["node"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "strict": true
  },
  "include": ["src/**/*"]
}
